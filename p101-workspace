#!/usr/bin/env bash
# p101-workspace — maintainer dispatcher for workspace lifecycle operations.

set -euo pipefail
CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")"

usage() {
  cat <<'USAGE'
Usage: ./p101-workspace <command> [args...]

Commands:
  setup          Configure and build the workspace for one compiler pair
  update         Update and build the workspace for one compiler pair
  update-all     Update and build every supported compiler pair
  check          Run post-update acceptance across every supported pair
  build          Build repositories for one configured compiler pair
  compilers      Discover supported C and C++ compilers
  environment    Check required build and analysis tools
  doctor         Report available toolchain and instrumentation support
  clone          Clone or align repositories to repos.lock
  lock           Refresh or verify the exact workspace revision lock
  push           Push committed repository changes
  distribute     Refresh shared CMake, scripts, links, and playground runners
  remove-retired Remove repositories no longer present in repos.txt
  toolchain-report
                 Capture a read-only host toolchain report

The root setup.sh, update-all.sh, and check-after-update-all.sh entry points
remain available for the most common workflows.
USAGE
}

[ "$#" -gt 0 ] || { usage; exit 2; }
command_name="$1"
shift

case "$command_name" in
  -h|--help|help) usage ;;
  setup) exec ./setup.sh "$@" ;;
  update) exec ./workspace/update.sh "$@" ;;
  update-all) exec ./update-all.sh "$@" ;;
  check|after-update) exec ./check-after-update-all.sh "$@" ;;
  build) exec ./workspace/build-repo.sh "$@" ;;
  compilers) exec ./workspace/check-compilers.sh "$@" ;;
  environment|env) exec ./workspace/check-env.sh "$@" ;;
  doctor) exec ./workspace/doctor.sh "$@" ;;
  clone|refresh) exec ./distribution/clone-repos.sh "$@" ;;
  lock) exec ./workspace/repos-lock.py "$@" ;;
  push) exec ./distribution/push-repos.sh "$@" ;;
  distribute)
    if [ "$#" -ne 0 ]; then
      printf 'p101-workspace distribute does not accept arguments\n' >&2
      exit 2
    fi
    ./distribution/copy-cmake.sh
    ./distribution/copy-scripts.sh
    ./distribution/copy-playground-track-scripts.sh
    ./distribution/link-flags.sh
    ./distribution/link-compilers.sh
    exec ./distribution/link-cmake.sh
    ;;
  remove-retired) exec ./distribution/remove-retired-repos.sh "$@" ;;
  toolchain-report) exec ./workspace/toolchain-report.sh "$@" ;;
  *)
    printf 'Unknown p101-workspace command: %s\n' "$command_name" >&2
    usage
    exit 2
    ;;
esac
