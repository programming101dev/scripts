#!/usr/bin/env bash
# p101 — small dispatcher for the p101 teaching tools.

set -euo pipefail
unset CDPATH
dispatch_cwd="$(pwd)"
export P101_DISPATCH_CWD="$dispatch_cwd"
CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")"
script_dir="$PWD"

usage() {
  cat <<'USAGE'
Usage: p101 <command> [args...]

Commands:
  observe       Capture one command into immutable event streams
  run           Capture one command and analyze the shared run model
  analyze       Verify and replay analyzers over an existing capture
  verify        Check an analysis model and optional expectations
  compare       Compare two analysis models semantically
  explain       Explain a finding using its causal neighborhood
  report        Render the correlated view of a p101 analysis
  trace         Render the trace view of a p101 analysis
  resource      Render the resource view of a p101 analysis
  walk          Run p101-error-path-walk
  fault-campaign Run contract-derived fault modes for selected wrappers
  interleaving-walk Explore bounded synchronization-event reorderings
  api-diff      Snapshot or compare governed public APIs
  fuzz          Run a repository's governed libFuzzer target
  audit         Run p101-wrapper-audit
  module-map    Run p101-module-map
  sync-check    Render the synchronization view of a p101 analysis
  mutation-check Run p101-mutation-check
  doctor        Run source/module preflight through p101-doctor
  playground    Run p101-tool-playground
  check         Check an analysis with rule packs, or run the full workflow
  corpus        Run the p101-tool-playground lesson corpus
  lab           Build the p101-tool-playground lab book
  lesson        Show, run, or verify one finding's teaching lesson
  lessons       Check, list, verify, report coverage, or summarize progress
  contracts     Check p101 tool README contracts
  tool-audit    Run the broader p101 tool audit
  stack-check   Run the p101 stack smoke
  after-update  Run checks intended after update-all.sh
  ci-preflight  Build and check clean local commits before any GitHub push
  html-report   Run p101-html-report.py
  cohort        Run p101-cohort-summary.py
  bug-bundle    Run p101-bug-bundle.sh

Tool locations may be overridden with the usual P101_* environment variables.
USAGE
}

find_tool() {
  env_name="$1"
  shift

  eval "configured=\${$env_name:-}"
  if [ -n "$configured" ]; then
    printf '%s\n' "$configured"
    return 0
  fi

  for candidate in "$@"; do
    if [ -z "$candidate" ]; then
      continue
    fi
    if [ -x "$candidate" ]; then
      if [[ "$candidate" = /* ]]; then
        printf '%s\n' "$candidate"
      else
        candidate_dir="$(CDPATH='' cd -- "$(dirname -- "$candidate")" && pwd -P)"
        printf '%s/%s\n' "$candidate_dir" "$(basename -- "$candidate")"
      fi
      return 0
    fi
    if command -v "$candidate" >/dev/null 2>&1; then
      command -v "$candidate"
      return 0
    fi
  done

  return 1
}

last_build_tool() {
  repo="$1"
  tool="$2"
  last_build_file="$repo/.last-runtime-build-dir"
  if [ ! -f "$last_build_file" ]; then
    last_build_file="$repo/.last-build-dir"
  fi

  if [ -f "$last_build_file" ]; then
    build_dir="$(cat "$last_build_file")"
    if [ -n "$build_dir" ]; then
      printf '%s\n' "$repo/$build_dir/$tool"
    fi
  fi
}

exec_found() {
  tool_label="$1"
  env_name="$2"
  shift 2

  tool_path="$(find_tool "$env_name" "$@")" || {
    echo "p101: ${tool_label} not found; build it first or set ${env_name}" >&2
    exit 2
  }
  CDPATH='' cd -- "$dispatch_cwd"
  exec "$tool_path" ${command_args[@]+"${command_args[@]}"}
}

if [ "$#" -eq 0 ]; then
  usage
  exit 2
fi

command_name="$1"
shift
command_args=("$@")

case "$command_name" in
  -h|--help|help)
    usage
    ;;
  observe)
    exec_found p101-observe P101_OBSERVE "$(last_build_tool ../programs/p101-observe p101-observe)" ../programs/p101-observe/build-clang-22/p101-observe ../programs/p101-observe/build-clang/p101-observe p101-observe
    ;;
  run)
    exec "$script_dir/runtime/p101-run.py" "$@"
    ;;
  analyze)
    exec ./runtime/p101-analyze.py "$@"
    ;;
  verify)
    exec ./runtime/p101-model.py verify "$@"
    ;;
  compare)
    exec ./runtime/p101-model.py compare "$@"
    ;;
  explain)
    exec ./runtime/p101-model.py explain "$@"
    ;;
  report)
    exec ./runtime/p101-view.py report "$@"
    ;;
  trace)
    exec ./runtime/p101-view.py trace "$@"
    ;;
  resource|resource-tracker)
    exec ./runtime/p101-view.py resource "$@"
    ;;
  walk|error-path-walk)
    observe_path="$(find_tool P101_OBSERVE "$(last_build_tool ../programs/p101-observe p101-observe)" ../programs/p101-observe/build-clang-22/p101-observe ../programs/p101-observe/build-clang/p101-observe p101-observe)" || {
      echo "p101: p101-observe not found; build it first or set P101_OBSERVE" >&2
      exit 2
    }
    model_path="$(find_tool P101_EVENT_MODEL "$(last_build_tool ../libraries/lib_tool_event p101-event-model)" ../libraries/lib_tool_event/build-clang-22/p101-event-model ../libraries/lib_tool_event/build-clang/p101-event-model p101-event-model)" || {
      echo "p101: p101-event-model not found; build it first or set P101_EVENT_MODEL" >&2
      exit 2
    }
    command_args=(-U "$script_dir/runtime/p101-run.py" -O "$observe_path" -Y "$script_dir/runtime/p101-analyze.py" -B "$model_path" "${command_args[@]}")
    exec_found p101-error-path-walk P101_ERROR_PATH_WALK "$(last_build_tool ../programs/p101-error-path-walk p101-error-path-walk)" ../programs/p101-error-path-walk/build-clang-22/p101-error-path-walk ../programs/p101-error-path-walk/build-clang/p101-error-path-walk p101-error-path-walk
    ;;
  fault-campaign)
    exec ./runtime/p101-fault-campaign.py "$@"
    ;;
  interleaving-walk)
    exec ./runtime/p101-interleaving-walk.py "$@"
    ;;
  api-diff)
    exec ./runtime/p101-api-diff.py "$@"
    ;;
  fuzz)
    if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
      cat <<'FUZZ_USAGE'
Usage: p101 fuzz [repository] [fuzz.sh arguments...]

Run the executable fuzz.sh owned by repository (default: the current
directory). The dispatcher does not invent a fallback target: a repository
without an executable fuzz.sh has no admitted fuzz contract.
FUZZ_USAGE
      exit 0
    fi
    fuzz_repo="$dispatch_cwd"
    if [ "$#" -gt 0 ] && [ -d "$1" ]; then
      fuzz_repo="$(CDPATH='' cd -- "$1" && pwd -P)"
      shift
    fi
    [ -x "$fuzz_repo/fuzz.sh" ] || {
      echo "p101: $fuzz_repo has no executable fuzz.sh" >&2
      exit 2
    }
    CDPATH='' cd -- "$fuzz_repo"
    exec ./fuzz.sh "$@"
    ;;
  audit|wrapper-audit)
    exec_found p101-wrapper-audit P101_WRAPPER_AUDIT ../programs/p101-wrapper-audit/p101-wrapper-audit p101-wrapper-audit
    ;;
  module-map)
    exec_found p101-module-map P101_MODULE_MAP "$(last_build_tool ../programs/p101-module-map p101-module-map)" ../programs/p101-module-map/build-clang-22/p101-module-map ../programs/p101-module-map/build-clang/p101-module-map p101-module-map
    ;;
  sync|sync-check)
    exec ./runtime/p101-view.py sync "$@"
    ;;
  mutation|mutation-check)
    exec_found p101-mutation-check P101_MUTATION_CHECK ../programs/p101-mutation-check/p101-mutation-check p101-mutation-check
    ;;
  doctor)
    exec_found p101-doctor P101_DOCTOR "$(last_build_tool ../programs/p101-doctor p101-doctor)" ../programs/p101-doctor/build-clang-22/p101-doctor ../programs/p101-doctor/build-clang/p101-doctor p101-doctor
    ;;
  playground)
    exec_found p101-tool-playground P101_TOOL_PLAYGROUND "$(last_build_tool ../playgrounds p101-tool-playground)" ../playgrounds/build-clang-22/p101-tool-playground ../playgrounds/build-clang/p101-tool-playground p101-tool-playground
    ;;
  check|check-model)
    for argument in "$@"; do
      case "$argument" in
        --rules|--rules=*)
          exec ./runtime/p101-model.py check "$@"
          ;;
      esac
    done
    exec ./runtime/p101-check.sh "$@"
    ;;
  corpus)
    exec ../playgrounds/corpus.sh "$@"
    ;;
  lab|playground-lab)
    exec ../playgrounds/lab.sh "$@"
    ;;
  lesson)
    case "${1:-}" in
      run)
        shift
        exec python3 ./runtime/p101_lessons.py --catalog ../playgrounds/lessons/manifest.json run "$@"
        ;;
      verify)
        shift
        exec python3 ./runtime/p101_lessons.py --catalog ../playgrounds/lessons/manifest.json verify-one "$@"
        ;;
      show)
        shift
        exec python3 ./runtime/p101_lessons.py --catalog ../playgrounds/lessons/manifest.json show "$@"
        ;;
      *)
        exec python3 ./runtime/p101_lessons.py --catalog ../playgrounds/lessons/manifest.json show "$@"
        ;;
    esac
    ;;
  lessons)
    exec python3 ./runtime/p101_lessons.py --catalog ../playgrounds/lessons/manifest.json "$@"
    ;;
  contracts|tool-contracts)
    exec ./checks/check-p101-tool-contracts.sh "$@"
    ;;
  tool-audit|audit-tools)
    exec ./checks/check-p101-tool-audit.sh "$@"
    ;;
  stack-check|stack)
    exec ./checks/check-p101-stack.sh "$@"
    ;;
  after-update|post-update)
    exec ./check-after-update-all.sh "$@"
    ;;
  ci-preflight|github-preflight)
    exec ./github-actions/preflight.sh "$@"
    ;;
  html-report)
    exec ./runtime/p101-html-report.py "$@"
    ;;
  cohort)
    exec ./runtime/p101-cohort-summary.py "$@"
    ;;
  bug-bundle)
    exec ./runtime/p101-bug-bundle.sh "$@"
    ;;
  *)
    echo "Unknown p101 command: $command_name" >&2
    usage
    exit 2
    ;;
esac
